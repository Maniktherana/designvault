{
  "name": "@repo/database",
  "private": true,
  "version": "0.0.0",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "generate": "pnpm dlx @better-auth/cli@latest generate --output ../database/schemas/auth-schema.ts",
    "lint": "biome check .",
    "format": "biome check . --write",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/node": "^22.13.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "pg": "^8.13.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@repo/tsconfig": "workspace:*",
    "drizzle-kit": "^0.30.4",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
