{
  "name": "devdirectory",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "shadcn": "cd packages/ui && pnpm shadcn"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@repo/tsconfig": "workspace:*",
    "turbo": "^2.3.0",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.2.1"
}
